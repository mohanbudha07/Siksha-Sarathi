# Runtime mode: use production only behind HTTPS with real secrets.
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Comma-separated React origins allowed to send session cookies.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

MYSQL_HOST=localhost
MYSQL_USER=siksha_user
MYSQL_PASSWORD=
MYSQL_DB=siksha_sarathi

# Optional: without a key, the Study Assistant uses its limited offline helper.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
